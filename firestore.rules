rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Helper Functions
    // ===============================================================
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isAdmin() {
      return isAuthenticated() && (
        (request.auth.token.email != null && request.auth.token.email.lower() in [
          "cesar.bronzatto@xertica.com",
          "gustavo.paula@xertica.com",
          "kefreen.batista@xertica.com"
        ]) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.roleId == 'admin')
      );
    }

    function isValidCountry(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() < 100 &&
             (!('code' in data) || (data.code is string && data.code.size() <= 5)) &&
             data.isActive is bool;
    }

    // ===============================================================
    // Rules
    // ===============================================================

    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if isAdmin() || (isAuthenticated() && request.auth.token.email != null && request.auth.token.email.lower() == userId.lower());
    }

    match /access_logs/{logId} {
      allow create: if isAuthenticated();
      allow read: if isAuthenticated();
    }
    
    match /trails/{trailId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
    
    match /modules/{moduleId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /areas/{areaId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /countries/{countryId} {
      allow read: if isAuthenticated();
      allow create: if isAdmin() && isValidCountry(request.resource.data);
      allow update: if isAdmin() && isValidCountry(request.resource.data);
      allow delete: if isAdmin();
    }

    match /roles/{roleId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /notifications/{notificationId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }
    
    match /user_progress/{progressId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    match /playbook_content/{contentId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /playbook_access_logs/{logId} {
      allow create: if isAuthenticated();
      allow read: if isAdmin();
    }

    match /playbook_sessions/{sessionId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /comments/{commentId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    match /leader_actions/{actionId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    match /point_history/{historyId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    match /deadline_notifications_sent/{id} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    match /trail_surveys/{surveyId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    match /recognitions/{recognitionId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    match /projects/{projectId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    match /eirDays/{dayId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /onboarding_feedback/{feedbackId} {
      allow read: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }
  }
}
